[General]
cmdenv-express-mode = true
cmdenv-autoflush = true
network = pqcbas.PQScenario
sim-time-limit = @SIM_TIME@s
**.scalar-recording = true
**.vector-recording = true
result-dir = results/@RUN_TAG@
seed-set = @SEED@

# Simulation playground bounds for StudyArea
*.playgroundSizeX = 700m
*.playgroundSizeY = 200m
*.playgroundSizeZ = 50m

# Obstacle shadowing

# TraCI / SUMO
*.manager.updateInterval = 0.1s
*.manager.host = "localhost"
*.manager.port = 9999
*.manager.seed = @SEED@
*.manager.autoShutdown = true
*.manager.launchConfig = xmldoc("studyarea.launchd.xml")

# RSU
*.rsu[0].mobility.x = 80
*.rsu[0].mobility.y = 36
*.rsu[0].mobility.z = 3
*.rsu[*].applType = "pqcbas.PQRSUApp"
*.rsu[*].appl.headerLength = 0bit
*.rsu[*].appl.sendBeacons = false
*.rsu[*].appl.dataOnSch = false
*.rsu[*].appl.rsuX = 80
*.rsu[*].appl.rsuY = 36
*.rsu[*].appl.rsuRadius = 150
*.rsu[*].appl.logicalDeadline = @LOGICAL_DEADLINE@s
*.rsu[*].appl.reassemblyTimeout = @REASSEMBLY_TIMEOUT@s
*.rsu[*].appl.cleanupInterval = 0.01s

# Dynamic vehicle nodes: segment each logical PQ object into application fragments.
*.node[*].applType = "pqcbas.PQVehicleApp"
*.node[*].appl.headerLength = 0bit
*.node[*].appl.sendBeacons = false
*.node[*].appl.dataOnSch = false
*.node[*].appl.logicalMessageInterval = @BEACON_INTERVAL@s
*.node[*].appl.logicalPayloadBytes = @LOGICAL_PAYLOAD_BYTES@
*.node[*].appl.fragmentPayloadBytes = @FRAGMENT_PAYLOAD_BYTES@
*.node[*].appl.fragmentHeaderBytes = @FRAGMENT_HEADER_BYTES@
*.node[*].appl.rsuX = 80
*.node[*].appl.rsuY = 36
*.node[*].appl.rsuRadius = 150
*.node[*].veinsmobility.x = 0
*.node[*].veinsmobility.y = 0
*.node[*].veinsmobility.z = 0
*.node[*].veinsmobility.setHostSpeed = false

# 802.11p MAC/PHY
*.connectionManager.sendDirect = true
*.connectionManager.maxInterfDist = 2600m
*.connectionManager.drawMaxIntfDist = false
*.**.nic.mac1609_4.useServiceChannel = false
*.**.nic.mac1609_4.txPower = 20mW
*.**.nic.mac1609_4.bitrate = @PHY_RATE@Mbps
*.**.nic.phy80211p.minPowerLevel = -110dBm
*.**.nic.phy80211p.useNoiseFloor = true
*.**.nic.phy80211p.noiseFloor = -98dBm
*.**.nic.phy80211p.usePropagationDelay = true

# Reuse Veins' standard config.xml/antenna.xml models or replace with a documented model.
*.**.nic.phy80211p.decider = xmldoc("config_pq.xml")
*.**.nic.phy80211p.analogueModels = xmldoc("config_pq.xml")
*.**.nic.phy80211p.antenna = xmldoc("antenna.xml", "/root/Antenna[@id='monopole']")
